# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Force specific file types to LF line endings
*.py text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.toml text eol=lf

# Windows shell scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.task binary
